# URL of your slskd instance
# Docker example:
# SLSKD_URL=http://slskd:5030
#
# Local installation:
# SLSKD_URL=http://localhost:5030
#
# Remote server:
# SLSKD_URL=http://192.168.1.100:5030
SLSKD_URL=http://slskd:5030
# slskd API key
SLSKD_API_KEY=YOUR_API_KEY
# Check interval (seconds)
CHECK_INTERVAL=60
# Seconds to wait before evaluating a downloader
GRACE_PERIOD=120
# Leecher thresholds are automatically read from your slskd configuration.
# Configure them under:
# transfers.groups.leechers.thresholds
# Browse retry delays (seconds)
# The bot browses immediately, then waits these delays
# before each additional retry.
#
# Example:
# Attempt 1 -> Browse immediately
# Attempt 2 -> Wait 2 seconds
# Attempt 3 -> Wait 5 seconds
# Attempt 4 -> Wait 10 seconds
#
BROWSE_RETRY_DELAYS=2,5,10
