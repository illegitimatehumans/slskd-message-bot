k# URL of your slskd instance
#
# Docker example:
# SLSKD_URL=http://slskd:5030
#
# Local installation:
# SLSKD_URL=http://localhost:5030
#
# Remote server:
# SLSKD_URL=http://192.168.1.100:5030
SLSKD_URL=http://slskd:5030

# slskd API key
SLSKD_API_KEY=YOUR_API_KEY

# Container user/group
# On Linux these are typically 1000:1000 for your first user.
PUID=1000
PGID=1000

# Timezone
TZ=America/New_York

# Check interval (seconds)
CHECK_INTERVAL=60

# Seconds to wait before evaluating a downloader
GRACE_PERIOD=120

# Recheck intervals (minutes)
GOOD_RECHECK_MINUTES=1440
LEECHER_RECHECK_MINUTES=60
UNKNOWN_RECHECK_MINUTES=10

# Progressive recheck delays after repeated browse failures (minutes)
UNKNOWN_RECHECK_BACKOFF_MINUTES=10,10,30,60,1440

# Historical statistics retention (days)
STATISTICS_RETENTION_DAYS=30

# Browse retry delays (seconds)
# The bot browses immediately, then waits these delays
# before each additional retry.
#
# Example:
# Attempt 1 -> Browse immediately
# Attempt 2 -> Wait 2 seconds
# Attempt 3 -> Wait 5 seconds
# Attempt 4 -> Wait 10 seconds
BROWSE_RETRY_DELAYS=2,5,10

# Leecher thresholds are automatically read from your slskd configuration.
# Configure them under:
# transfers.groups.leechers.thresholds

# Run without sending warning messages
# Set to false to enable warning messages.
DRY_RUN=true
